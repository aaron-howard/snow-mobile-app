# pnpm configuration for an Expo / React Native + WatermelonDB project.
#
# node-linker=hoisted — Metro and React Native's native-module resolution
# walk a flat node_modules layout. pnpm's default isolated layout breaks
# this. `hoisted` makes pnpm produce an npm-shaped tree (so RN works) while
# keeping pnpm's content-addressable store on disk (so disk usage stays low).
node-linker=hoisted

# Metro/React Native expects a flatter node_modules layout than pnpm's default.
# Keep it hoisted enough to work, but do not hoist every package to avoid
# duplicate transitive copies of packages like @babel/runtime.
node-linker=hoisted

# Force a single compatible Babel runtime for the RN/Jest toolchain.
overrides.@babel/runtime=7.29.7

# Match what we used for npm (--legacy-peer-deps). RN ecosystem peer ranges
# are noisy; strict mode breaks otherwise-valid installs.
strict-peer-dependencies=false
auto-install-peers=true
