# Local-dev secrets for `wrangler dev`.
# Copy to `.dev.vars` and fill in. Never commit `.dev.vars`.

# Clerk — server secret key (NOT the publishable key).
# Get it from https://dashboard.clerk.com/ → API Keys → Secret keys.
CLERK_SECRET_KEY=

# Neon connection string — use the *pooled* one for the HTTP driver.
# Looks like: postgres://<user>:<pwd>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=
