# Copy this file to `.env` and fill in real values.
# Never commit `.env` — see .gitignore.

# Clerk — publishable key is safe to ship in the client.
# Get it from https://dashboard.clerk.com/ → API Keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Cloudflare Worker base URL — your deployed Hono API.
# Local dev:   http://localhost:8787  (served by `wrangler dev` from workers/)
# Production:  https://api.<your-account-subdomain>.workers.dev
EXPO_PUBLIC_API_BASE_URL=
