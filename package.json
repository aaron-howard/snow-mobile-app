{
  "name": "sn-cert-prep",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial study app for ServiceNow certifications (CSA, CAD, CIS-*). Not affiliated with or endorsed by ServiceNow, Inc.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:properties": "jest --testPathPattern='\\.property\\.test\\.ts'",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.36",
    "@nozbe/watermelondb": "^0.27.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~54.0.0",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-file-system": "~18.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~2.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.19.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.0.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.60.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.11.0",
    "eslint-config-expo": "~8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^3.23.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.8.13",
      "expo-dev-launcher>ajv": ">=8.18.0",
      "uuid": ">=11.1.1"
    }
